# Database (Optional for local dev, uses local embedded DB if empty. For production, use Neon / Supabase URL)
DATABASE_URL=postgres://user:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require

# Master API Key (Bearer token for automated publishing)
CMS_API_KEY=sy_live_your_32_or_64_char_random_token
NEXT_PUBLIC_CMS_API_KEY=sy_live_your_32_or_64_char_random_token

# Cloudinary Storage (Optional for local dev, uses local /public/uploads if empty)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=stackyup

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://stackyup.com

# Upstash Redis / Vercel KV (Optional for local dev, uses in-memory cache if empty. For production, connect Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Monetization & Ads (Google AdSense or Direct Affiliate Promos)
# Master toggle: set to false to completely disable all ads across the site
NEXT_PUBLIC_ADS_ENABLED=true
# Google AdSense Client ID (e.g. ca-pub-1234567890123456). If empty, site runs sleek customizable direct promos
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Optional specific AdSense Slot IDs (if left empty, falls back to custom affiliate banners configured in src/config/ads.ts)
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_IN_FEED=
NEXT_PUBLIC_ADS_IN_ARTICLE=true

